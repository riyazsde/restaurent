# ========================================================
# RESTAURANT POS & WEBSITE INTEGRATION - ENVIRONMENT EXAMPLE
# ========================================================

# Base API endpoint for backend service
REACT_APP_API_URL=https://pos-backend-7xuw.onrender.com/api/v1
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_publishable_key

# Real-time WebSocket / Socket.io connection URL
REACT_APP_SOCKET_URL=https://pos-backend-7xuw.onrender.com

# S3 bucket / CDN base URL for images and uploaded assets
REACT_APP_IMAGE_BASE_URL=https://triaxxss.s3.ap-south-1.amazonaws.com/

# Vite compatibility fallback
VITE_API_URL=https://pos-backend-7xuw.onrender.com/api/v1

# Stripe POS server configuration is shown only in backend deployment settings.
# Do not put Stripe keys or webhook secrets in this frontend environment.
# Configure STRIPE_SECRET_KEY, STRIPE_POS_SUCCESS_URL, STRIPE_POS_CANCEL_URL,
# and STRIPE_POS_WEBHOOK_SECRET on the API server.
# Local development server port
PORT=3000

# Sourcemaps generation setting
GENERATE_SOURCEMAP=true
